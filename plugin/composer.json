{
	"name": "ashrafchitambaa/ac-mcp",
	"description": "Lets AI clients build and edit Bricks and Elementor pages through MCP.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"homepage": "https://ashrafchitambaa.com",
	"authors": [
		{
			"name": "Ashraf Chitambaa",
			"homepage": "https://ashrafchitambaa.com"
		}
	],
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"brain/monkey": "^2.6",
		"phpunit/phpunit": "^10.5",
		"wp-coding-standards/wpcs": "^3.1",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"AcMcp\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"AcMcp\\Tests\\": "tests/"
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs",
		"lint:fix": "phpcbf"
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true,
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
