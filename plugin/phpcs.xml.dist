<?xml version="1.0"?>
<ruleset name="AC MCP for Bricks and Elementor">
	<description>WordPress Coding Standards for AC MCP for Bricks and Elementor.</description>

	<file>ac-mcp-for-bricks-elementor.php</file>
	<file>uninstall.php</file>
	<file>src</file>

	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<arg name="colors"/>

	<config name="minimum_wp_version" value="7.1"/>
	<config name="testVersion" value="8.1-"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress">
		<!-- PSR-4 file names (ClassName.php) instead of class-name.php. -->
		<exclude name="WordPress.Files.FileName"/>
		<!-- Short one-line accessors are documented by their names and types. -->
		<exclude name="Squiz.Commenting.FunctionComment.Missing"/>
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamTag"/>
		<exclude name="Squiz.Commenting.VariableComment.Missing"/>
		<exclude name="Generic.Commenting.DocComment.MissingShort"/>
		<exclude name="Squiz.Commenting.FunctionComment.MissingParamComment"/>
		<!-- Native PHP 8.1 types are authoritative; partial @param blocks only add array shapes. -->
		<exclude name="Squiz.Commenting.FunctionComment.ParamNameNoMatch"/>
		<exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint"/>
		<exclude name="Squiz.Commenting.FunctionCommentThrowTag.Missing"/>
		<!-- Exception messages become JSON tool errors, never HTML output. -->
		<exclude name="WordPress.Security.EscapeOutput.ExceptionNotEscaped"/>
		<!-- "$parent" is the natural name for a parent element ID. -->
		<exclude name="Universal.NamingConventions.NoReservedKeywordParameterNames"/>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ac-mcp-for-bricks-elementor"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ac_mcp"/>
				<element value="AcMcp"/>
			</property>
		</properties>
	</rule>
</ruleset>
