{
	"compilerOptions": {
		"target": "ES2020",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"types": [ "node" ],
		"lib": [ "DOM", "DOM.Iterable", "ES2022" ]
	},
	"include": [ "src" ]
}
